<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/styles.css"> 
    <style>
        /* Estructura de dos columnas */
        body { display: flex; margin: 0; min-height: 100vh; font-family: sans-serif; }
        .sidebar { width: 250px; background-color: #f8f9fa; padding: 20px; border-right: 1px solid #ddd; }
        .main-content { flex: 1; padding: 20px; }

        /* Estilos del Formulario */
        .form-container { max-width: 600px; margin: 0 auto; padding: 20px; border: 1px solid #ccc; border-radius: 8px; background-color: #fff; }
        .form-group { margin-bottom: 15px; }
        .form-group label { display: block; margin-bottom: 5px; font-weight: bold; }
        .form-group input, .form-group textarea { width: 100%; padding: 8px; box-sizing: border-box; border: 1px solid #ccc; border-radius: 4px; }
        .readonly-field { background-color: #e9ecef; cursor: not-allowed; color: #6c757d; }
        .error-box { background-color: #f8d7da; color: #721c24; padding: 10px; border-radius: 4px; margin-bottom: 20px; border: 1px solid #f5c6cb; }
        .btn-update { background-color: #007bff; color: white; padding: 10px 15px; border: none; border-radius: 4px; cursor: pointer; }
    </style>
</head>
<body>

    <aside class="sidebar">
        <h1>Marketplace</h1>
        <nav style="display: flex; flex-direction: column; gap: 15px; margin-top: 20px;">
            <a href="/inventory">Catálogo General</a>
            <a href="/inventory/create">+ Publicar Repuesto</a>
            <a href="/inventory/my-publications">Mis Publicaciones</a>
            <form action="/auth/signout" method="POST">
                <button type="submit">Cerrar Sesión</button>
            </form>
        </nav>
    </aside>

    <main class="main-content">
        <div class="form-container">
            <h2 style="color: #007bff;"><%= title %></h2>
            <p style="font-size: 0.9em; color: #6c757d;">Editando ID: #<%= item.id %></p>

            <% if (errors && errors.length > 0) { %>
                <div class="error-box">
                    <strong>Corrige lo siguiente:</strong>
                    <ul>
                        <% errors.forEach(err => { %>
                            <li><%= err.msg || err %></li>
                        <% }) %>
                    </ul>
                </div>
            <% } %>

            <form action="/inventory/<%= item.id %>/edit" method="POST" enctype="multipart/form-data" onsubmit="return confirm('¿Seguro que deseas guardar estos cambios?');">
                
                <div class="form-group">
                    <label for="title">Título de la publicación</label>
                    <input type="text" id="title" name="title" value="<%= old.title || item.title %>" required>
                </div>

                <div class="form-group">
                    <label>Número de Parte (No editable)</label>
                    <input type="text" value="<%= item.part_number %>" class="readonly-field" readonly>
                </div>

                <div class="form-group">
                    <label for="chassisModel">Modelo del Chasis/Compatibilidad</label>
                    <input type="text" id="chassisModel" name="chassisModel" value="<%= old.chassisModel || item.chassis_model %>" required>
                </div>

                <div class="form-group">
                    <label for="price">Precio ($)</label>
                    <input type="number" step="0.01" min="0.1" id="price" name="price" value="<%= old.price || item.price %>" required>
                </div>

                <div class="form-group">
                    <label for="description">Descripción y notas técnicas</label>
                    <textarea id="description" name="description" rows="4"><%= old.description || item.description %></textarea>
                </div>

                <div class="form-group">
                    <label for="image">Cambiar fotografía (Opcional)</label>
                    <input type="file" id="image" name="image" accept="image/*">
                    <small style="color: #6c757d;">Si no seleccionas nada, se mantendrá la imagen actual.</small>
                </div>

                <div style="margin-top: 20px;">
                    <button type="submit" class="btn-update">Guardar Cambios</button>
                    <a href="/inventory/my-publications" style="margin-left: 15px; color: #6c757d;">Cancelar</a>
                </div>
            </form>
        </div>
    </main>
</body>
</html>