<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/styles.css"> 
    <style>
        /* Estructura de dos columnas */
        body { display: flex; margin: 0; min-height: 100vh; font-family: sans-serif; }
        .sidebar { width: 250px; background-color: #f8f9fa; padding: 20px; border-right: 1px solid #ddd; }
        .main-content { flex: 1; padding: 20px; }

        /* Estilos del Contenedor de Detalle */
        .detail-container { max-width: 800px; margin: 0 auto; padding: 20px; border: 1px solid #ccc; border-radius: 8px; background-color: #fff; }
        .detail-content { display: flex; gap: 20px; margin-top: 20px; }
        .detail-image { flex: 1; max-width: 400px; }
        .detail-image img { width: 100%; height: auto; border-radius: 8px; border: 1px solid #eee; }
        .detail-info { flex: 1; display: flex; flex-direction: column; gap: 15px; }
        .price-tag { font-size: 2em; color: #28a745; margin: 0; }
        .info-row { background-color: #f8f9fa; padding: 10px; border-radius: 4px; }
        .description-box { background-color: #f8f9fa; padding: 15px; border-radius: 4px; border-left: 4px solid #6c757d; white-space: pre-wrap; }
        .btn-contact { background-color: #007bff; color: white; padding: 12px 20px; border: none; border-radius: 4px; text-decoration: none; text-align: center; display: block; }
    </style>
</head>
<body>

    <aside class="sidebar">
        <h1>Marketplace</h1>
        <nav style="display: flex; flex-direction: column; gap: 15px; margin-top: 20px;">
            <a href="/inventory">Catálogo General</a>
            <a href="/inventory/create">+ Publicar Repuesto</a>
            <a href="/inventory/my-publications">Mis Publicaciones</a>
            <form action="/auth/signout" method="POST">
                <button type="submit">Cerrar Sesión</button>
            </form>
        </nav>
    </aside>

    <main class="main-content">
        <% if (successMessage) { %>
            <div style="background-color: #d4edda; color: #155724; padding: 15px; border: 1px solid #c3e6cb; border-radius: 4px; margin-bottom: 20px;">
                ✅ <%= successMessage %>
            </div>
        <% } %>

        <div class="detail-container">
            <div>
                <a href="/inventory" style="color: #6c757d; text-decoration: none;">&larr; Volver al catálogo</a>
                <h2 style="margin-top: 15px;"><%= item.title %></h2>
                <small style="color: #6c757d;">Publicado el: <%= new Date(item.created_at).toLocaleDateString('es-ES') %></small>
            </div>

            <div class="detail-content">
                <div class="detail-image">
                    <img src="<%= item.image_url || 'https://via.placeholder.com/600?text=Sin+Imagen' %>" alt="<%= item.title %>">
                </div>
                
                <div class="detail-info">
                    <h3 class="price-tag">$<%= item.price %></h3>
                    <div class="info-row">
                        <strong>N° de Parte:</strong><br><%= item.part_number %>
                    </div>
                    <div class="info-row">
                        <strong>Compatibilidad / Chasis:</strong><br><%= item.chassis_model %>
                    </div>

                    <div style="margin-top: auto;">
                        <% if (currentUserId === item.user_id) { %>
                            <div style="background-color: #e9ecef; padding: 15px; border-radius: 4px; text-align: center;">
                                <strong>Esta es tu publicación</strong>
                                <div style="display: flex; gap: 10px; justify-content: center; margin-top: 10px;">
                                    <a href="/inventory/<%= item.id %>/edit" style="background-color: #ffc107; color: black; padding: 8px 15px; text-decoration: none; border-radius: 4px;">Editar</a>
                                    <form action="/inventory/<%= item.id %>/delete" method="POST" onsubmit="return confirm('¿Seguro?');" style="margin: 0;">
                                        <button type="submit" style="background-color: #dc3545; color: white; border: none; padding: 8px 15px; border-radius: 4px; cursor: pointer;">Eliminar</button>
                                    </form>
                                </div>
                            </div>
                        <% } else { %>
                            <a href="/chat/<%= item.id %>" class="btn-contact">💬 Contactar Vendedor</a>
                        <% } %>
                    </div>
                </div>
            </div>

            <% if (item.description) { %>
                <div style="margin-top: 20px;">
                    <h3>Notas Técnicas:</h3>
                    <div class="description-box"><%= item.description %></div>
                </div>
            <% } %>
        </div>
    </main>
</body>
</html>